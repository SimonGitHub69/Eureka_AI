DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=127.0.0.1,localhost,*
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,https://127.0.0.1:8443,https://localhost:8443
CARBON_URL=http://127.0.0.1:8001/
DATABASE_URL=postgres://eureka:eureka@127.0.0.1:5432/eureka_ai
LANGUAGE_CODE=it-it
TIME_ZONE=Europe/Rome

# AI Assistant — "ollama" (gratuito, locale), "openai" oppure "groq"
AI_BACKEND=groq
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI (solo se AI_BACKEND=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Groq (solo se AI_BACKEND=groq) — chiave gratuita da https://console.groq.com/
# Free tier: limiti TPD/RPD per modello (verifica su https://console.groq.com/docs/models).
# groq/compound-mini è leggero e adatto a output JSON/SQL; openai/gpt-oss-20b ha quota più bassa.
GROQ_API_KEY=gsk_...
GROQ_MODEL=groq/compound-mini
# Riduce token in uscita e consumo quota giornaliera (550 consigliato).
GROQ_MAX_TOKENS=550
